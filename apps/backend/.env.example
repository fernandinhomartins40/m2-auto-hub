# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://m2:m2_dev_2026@localhost:5432/m2_auto_hub?schema=public

# JWT
JWT_SECRET=m2_auto_hub_jwt_secret_dev_2026_change_in_production_now
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Services
ALPR_SERVICE_URL=http://localhost:3082

# Consulta de placa (dados tecnicos do veiculo)
# Sem os tokens abaixo a consulta externa fica desligada e o sistema usa apenas
# a base propria (tabela vehicle_plate_lookups), caindo no cadastro manual
# quando a placa ainda nao e conhecida.
# Tokens gratuitos em https://app.apibrasil.io -> Minhas APIs -> API Placa Dados
PLATE_LOOKUP_API_URL=https://gateway.apibrasil.io/api/v2/vehicles
PLATE_LOOKUP_BEARER_TOKEN=
PLATE_LOOKUP_DEVICE_TOKEN=
PLATE_LOOKUP_TIMEOUT_MS=8000

# Logging
LOG_LEVEL=info
