model LoyaltyReward {
  id                String              @id @default(uuid())
  name              String
  description       String              @db.Text
  type              LoyaltyRewardType
  pointsCost        Int
  discountValue     Decimal?            @db.Decimal(10, 2)
  minLevel          CustomerLevel       @default(BRONZE)
  status            LoyaltyRewardStatus @default(ACTIVE)
  usageInstructions String?             @db.Text
  expiresAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  redemptions  LoyaltyRedemption[]
  transactions LoyaltyTransaction[]

  @@index([status])
  @@index([minLevel])
  @@index([type])
  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id          String                  @id @default(uuid())
  customerId  String
  rewardId    String
  code        String                  @unique
  pointsSpent Int
  status      LoyaltyRedemptionStatus @default(AVAILABLE)
  notes       String?                 @db.Text
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward       LoyaltyReward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([customerId, createdAt])
  @@index([rewardId])
  @@index([status])
  @@map("loyalty_redemptions")
}

model LoyaltyTransaction {
  id           String                 @id @default(uuid())
  customerId   String
  rewardId     String?
  redemptionId String?
  orderId      String?
  revisionId   String?
  type         LoyaltyTransactionType
  points       Int
  description  String
  metadata     Json?
  createdAt    DateTime               @default(now())

  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward     LoyaltyReward?     @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  redemption LoyaltyRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([rewardId])
  @@index([redemptionId])
  @@index([orderId])
  @@index([revisionId])
  @@unique([orderId, type])
  @@unique([revisionId, type])
  @@map("loyalty_transactions")
}

// ==================== RELACIONAMENTO COM O CLIENTE ====================

/// Categoria/tipo de interação de relacionamento. As categorias "de sistema"
/// (isSystem = true) reproduzem os segmentos originais (aniversário, inativos,
/// pós-venda, VIP) e não podem ser excluídas, apenas editadas. Categorias
/// customizadas são criadas pelo admin com regras próprias.
model RelationshipCategory {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String  @default("")
  icon        String  @default("MessageCircle")
  accentColor String  @default("#f97316")
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Regras de segmentação combinadas com AND. Cada item:
  /// { field, operator, value, value2? }
  rules   Json   @default("[]")
  sortBy  String @default("daysSinceLastInteraction")
  sortDir String @default("asc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates RelationshipTemplate[]
  messages  RelationshipMessage[]

  @@index([isActive, sortOrder])
  @@map("relationship_categories")
}

/// Modelo de mensagem (WhatsApp) associado a uma categoria. O corpo suporta
/// placeholders como {{firstName}}, {{name}}, {{totalSpent}}, etc.
model RelationshipTemplate {
  id         String  @id @default(uuid())
  categoryId String
  name       String
  body       String  @db.Text
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  RelationshipCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  messages  RelationshipMessage[]

  @@index([categoryId, isActive, sortOrder])
  @@map("relationship_templates")
}

enum RelationshipMessageStatus {
  PENDING /// aberto no WhatsApp, aguardando confirmação do admin
  SENT /// admin confirmou o envio
}

enum RelationshipMessageOutcome {
  PENDING /// sem retorno registrado ainda
  REPLIED /// cliente respondeu
  SCHEDULED /// cliente agendou algo (revisão/visita)
  PURCHASED /// gerou nova venda
  NO_REPLY /// sem resposta
}

/// Registro de cada mensagem de relacionamento disparada para um cliente.
/// Guarda snapshots (nome do cliente, categoria e corpo) para o histórico
/// sobreviver a edições/exclusões de categorias, templates ou clientes.
model RelationshipMessage {
  id         String  @id @default(uuid())
  customerId String?
  categoryId String?
  templateId String?
  adminId    String?

  // Snapshots imutáveis para o histórico.
  customerName String
  customerPhone String
  categoryKey  String
  categoryName String
  templateName String?
  messageBody  String                     @db.Text

  status  RelationshipMessageStatus  @default(PENDING)
  outcome RelationshipMessageOutcome @default(PENDING)
  notes   String?                    @db.Text

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category RelationshipCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  template RelationshipTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  admin    Admin?                @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([categoryKey, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("relationship_messages")
}
