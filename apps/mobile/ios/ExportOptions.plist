<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Opções de exportação do IPA usadas pelo `flutter build ipa`.

  Ajuste antes do primeiro build assinado:
   - teamID: o Team ID (10 chars) da sua conta Apple Developer.
   - method: para instalar em iPhones de teste específicos, use "ad-hoc"
             (exige os UDIDs dos aparelhos no provisioning profile).
             Outras opções: "app-store" (TestFlight/loja), "development".
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>ad-hoc</string>

    <key>teamID</key>
    <string>SEU_TEAM_ID</string>

    <key>signingStyle</key>
    <string>manual</string>

    <key>compileBitcode</key>
    <false/>

    <key>stripSwiftSymbols</key>
    <true/>

    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
