{
  "name": "m2-auto-hub",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test --filter=@m2/frontend",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down --remove-orphans",
    "docker:logs": "docker compose logs -f",
    "clean": "rimraf .turbo node_modules apps/frontend/node_modules apps/backend/node_modules apps/frontend/dist apps/backend/dist"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "turbo": "^2.5.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
